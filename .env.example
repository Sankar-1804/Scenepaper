# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Runtime LLM (Call A verification, Call B structuring, SearXNG query-gen).
# See docs/api-notes.md "Runtime LLM API: Google Gemini API".
GEMINI_API_KEY=

# Self-hosted SearXNG metasearch instance. Hosting location not yet decided
# — see issue #21. Placeholder default assumes a local instance.
SEARXNG_BASE_URL=http://localhost:8888

# Pexels developer key — never obtained yet, see docs/api-notes.md.
PEXELS_API_KEY=

# Local Voicebox REST API. Runs on the builder's Mac for the demo (not a
# cloud tunnel) — see ai-docs/Handoff-session 1.md section 7.
VOICEBOX_BASE_URL=http://localhost:8000
